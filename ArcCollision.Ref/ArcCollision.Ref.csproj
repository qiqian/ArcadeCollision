<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 so Unity 2022 (Mono / IL2CPP, .NET Standard 2.1 API level)
         can consume the assembly as a precompiled managed plugin. Builds with the
         .NET 8 SDK; no separate runtime is required. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- C# 9 is the newest language version Unity 2022 LTS compiles, so the
         sources stay usable both as a precompiled plugin and when dropped
         directly into an Assets folder. Implicit (global) usings are a C# 10
         feature, hence the explicit using directives in every file. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArcCollision.Ref</AssemblyName>
    <RootNamespace>ArcCollision.Ref</RootNamespace>
    <LangVersion>9</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Description>Reference (correctness-first) implementation of the ArcadeCollision toolkit.</Description>
  </PropertyGroup>

</Project>
